# Google Sheets Configuration
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SHEETS_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email@gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Instagram Integration (optional)
INSTAGRAM_USER_ID=your_instagram_user_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Slack Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CONTENT_REQUEST_CHANNEL_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Bootstrap Admin Credentials (used as fallback when Google Sheets isn't available)
# IMPORTANT: Keep .env.local out of version control by ensuring .gitignore includes "*.env.local"
SGA_BOOTSTRAP_USERNAME=your_username
SGA_BOOTSTRAP_PASSWORD=your_secure_password
SGA_BOOTSTRAP_NAME="Your Admin Name"

# Form Configuration (optional)
CONTENT_REQUEST_FORM_SLUG=sga-content-request
